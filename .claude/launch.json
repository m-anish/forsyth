{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "forsyth-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4100", "--directory", "site"],
      "port": 4100
    },
    {
      "name": "forsyth-dashboard",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["tools/dev-proxy.py"],
      "port": 4180
